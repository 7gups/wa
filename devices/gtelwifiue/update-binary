#!/sbin/sh
OUTFD=$2
ZIPFILE=$3
ui_print() { echo -e "ui_print $1\nui_print" >&$OUTFD; }
ui_print "Flashing gtelwifiue stock firmware..."
mkdir -p /tmp/twrp_zip && cd /tmp/twrp_zip
unzip -o "$ZIPFILE" -d /tmp/twrp_zip >/dev/null
[ -f /tmp/twrp_zip/# Auto-generated partition dd map for gtelwifiue.img ] && ui_print "Flashing # Auto-generated partition dd map for gtelwifiue..." && dd if=/tmp/twrp_zip/# Auto-generated partition dd map for gtelwifiue.img of=/dev/block/bootdevice/by-name/# Auto-generated partition dd map for gtelwifiue 2>/dev/null || true
[ -f /tmp/twrp_zip/boot.img ] && ui_print "Flashing boot..." && dd if=/tmp/twrp_zip/boot.img of=/dev/block/bootdevice/by-name/boot 2>/dev/null || true
[ -f /tmp/twrp_zip/recovery.img ] && ui_print "Flashing recovery..." && dd if=/tmp/twrp_zip/recovery.img of=/dev/block/bootdevice/by-name/recovery 2>/dev/null || true
ui_print "Done. Reboot when ready."
exit 0

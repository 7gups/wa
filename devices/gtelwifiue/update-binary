#!/sbin/sh
OUTFD=$2
ZIPFILE=$3
ui_print() { echo -e "ui_print $1\nui_print" >&$OUTFD; }
ui_print "Flashing gtelwifiue stock firmware..."
mkdir -p /tmp/twrp_zip && cd /tmp/twrp_zip
unzip -o "$ZIPFILE" -d /tmp/twrp_zip >/dev/null

BYNAME=""
for candidate in /dev/block/bootdevice/by-name /dev/block/by-name /dev/block/platform/*/by-name /dev/block/platform/*/*/by-name; do
  if [ -d "$candidate" ]; then
    BYNAME="$candidate"
    break
  fi
done
if [ -z "$BYNAME" ]; then
  ui_print "ERROR: no by-name partition directory found on this device."
  ui_print "This device's SoC uses a partition layout this zip doesn't recognize."
  exit 1
fi
ui_print "Using partition path: $BYNAME"
[ -f /tmp/twrp_zip/boot.img ] && ui_print "Flashing boot..." && dd if=/tmp/twrp_zip/boot.img of="$BYNAME"/boot 2>/dev/null || true
[ -f /tmp/twrp_zip/recovery.img ] && ui_print "Flashing recovery..." && dd if=/tmp/twrp_zip/recovery.img of="$BYNAME"/recovery 2>/dev/null || true
ui_print "Done. Reboot when ready."
exit 0
